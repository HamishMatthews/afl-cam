[Unit]
Description=afl-camd field recording daemon (iPhone control + web UI + API)
Documentation=file:/home/hamish/Documents/afl-cam/iphone-control-plan.md
After=network-online.target mediamtx.service
Wants=network-online.target mediamtx.service

[Service]
Type=simple
User=hamish
WorkingDirectory=/home/hamish/Documents/afl-cam
# stdlib-only module; the project venv python is fine headless
ExecStart=/home/hamish/Documents/afl-cam/.venv/bin/python -m afl_cam.cli daemon
Restart=on-failure
RestartSec=3
# bind port 80 without running as root
AmbientCapabilities=CAP_NET_BIND_SERVICE
Environment=AFL_CAM_PORT=80

[Install]
WantedBy=multi-user.target
