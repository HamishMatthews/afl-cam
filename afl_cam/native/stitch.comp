#version 450

// GPU stitch, ANALYTIC spherical warp: each output pixel projects through the
// per-camera (K @ R^T) into the source frame — the exact math of
// afl_cam.stitcher._spherical_maps, evaluated in the shader. No map textures,
// no OpenCV machinery: out = tex0(s0) * w0 + tex1(s1) * w1.
//
// K is the MEASURED checkerboard pinhole matrix (alpha=1 optimal). The source
// textures are RAW sensor frames: the pinhole coordinates are pushed through
// the FORWARD radial distortion (Newton solve on the cubic) before sampling,
// so no per-frame undistortion pass is needed. Tangential terms (p1, p2) are
// ~3e-4 — below the sampling error — and are ignored.

layout(local_size_x = 16, local_size_y = 16) in;

layout(set = 0, binding = 0) uniform sampler2D tex0;
layout(set = 0, binding = 1) uniform sampler2D tex1;
layout(set = 0, binding = 2) uniform sampler2D w0;
layout(set = 0, binding = 3) uniform sampler2D w1;
layout(set = 0, binding = 4) buffer SSBO { uint data[]; } ssbo;
layout(set = 0, binding = 5) buffer ParamsBuf { float f[]; } P;

const float PI = 3.14159265359;

// returns RAW source pixel coords (continuous), or (-1,-1) when outside the map
vec2 warp_cam(int cam, vec2 p) {
    // f layout per cam (28): krinv(9) tl(2) off(2) mapwh(2)
    //   pin fx,fy,cx,cy(4)  raw fx,fy,cx,cy(4)  k1,k2,p1,p2,k3(5)
    int base = 8 + cam * 28;
    float tl_x = P.f[base + 9], tl_y = P.f[base + 10];
    float off_x = P.f[base + 11], off_y = P.f[base + 12];
    float map_w = P.f[base + 13], map_h = P.f[base + 14];
    float fx = P.f[base + 15], fy = P.f[base + 16];
    float cx = P.f[base + 17], cy = P.f[base + 18];
    float rfx = P.f[base + 19], rfy = P.f[base + 20];
    float rcx = P.f[base + 21], rcy = P.f[base + 22];
    float k1 = P.f[base + 23], k2 = P.f[base + 24], k3 = P.f[base + 27];

    vec2 mc = p - vec2(off_x, off_y);
    if (mc.x < 0.0 || mc.x >= map_w || mc.y < 0.0 || mc.y >= map_h)
        return vec2(-1.0);

    float u = (mc.x + tl_x) / P.f[4];
    float v = (mc.y + tl_y) / P.f[4];

    float sin_v = sin(PI - v);
    vec3 dir = vec3(sin_v * sin(u), cos(PI - v), sin_v * cos(u));

    vec3 xyz;
    xyz.x = P.f[base] * dir.x + P.f[base + 1] * dir.y + P.f[base + 2] * dir.z;
    xyz.y = P.f[base + 3] * dir.x + P.f[base + 4] * dir.y + P.f[base + 5] * dir.z;
    xyz.z = P.f[base + 6] * dir.x + P.f[base + 7] * dir.y + P.f[base + 8] * dir.z;

    if (xyz.z <= 0.0)
        return vec2(-1.0);
    vec2 src = xyz.xy / xyz.z;   // pinhole (undistorted) pixel coords

    // forward radial distortion: given undistorted radius ru, solve
    //   r * (1 + k1 r^2 + k2 r^4 + k3 r^6) = ru   for r  (Newton, 4 iters)
    // The polynomial is normalized by the ORIGINAL camera matrix, so the
    // distorted point is reconstructed with the raw (fx, fy, cx, cy).
    vec2 xn = (src - vec2(cx, cy)) / vec2(fx, fy);
    float ru = length(xn);
    float r = ru;
    for (int i = 0; i < 4; i++) {
        float r2 = r * r;
        float fv = r * (1.0 + k1 * r2 + k2 * r2 * r2 + k3 * r2 * r2 * r2) - ru;
        float fp = 1.0 + 3.0 * k1 * r2 + 5.0 * k2 * r2 * r2 + 7.0 * k3 * r2 * r2 * r2;
        r -= fv / fp;
    }
    return vec2(rcx, rcy) + xn * (r / max(ru, 1e-9)) * vec2(rfx, rfy);
}

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (p.x >= int(P.f[0]) || p.y >= int(P.f[1])) return;

    vec2 canvas_dims = vec2(P.f[0], P.f[1]);
    vec2 src_dims = vec2(P.f[2], P.f[3]);
    vec2 c = vec2(p);
    vec2 uv = (c + vec2(0.5)) / canvas_dims;   // exact texel p (NEAREST)

    vec2 s0 = warp_cam(0, c);
    vec2 s1 = warp_cam(1, c);

    float w0v = texture(w0, uv).r;
    float w1v = texture(w1, uv).r;

    // s0/s1 are pixel-corner coordinates; GLSL texel centers sit at
    // (i+0.5)/N, so +0.5 aligns NEAREST sampling with pixel corners.
    vec3 c0 = texture(tex0, (s0 + vec2(0.5)) / src_dims).rgb;   // s0 < 0 -> border black
    vec3 c1 = texture(tex1, (s1 + vec2(0.5)) / src_dims).rgb;

    vec3 outv = c0 * w0v + c1 * w1v;
    uint packed =
        (uint(outv.r * 255.0 + 0.5) & 0xffu) |
        ((uint(outv.g * 255.0 + 0.5) & 0xffu) << 8) |
        ((uint(outv.b * 255.0 + 0.5) & 0xffu) << 16);
    ssbo.data[uint(p.y * int(P.f[0]) + p.x)] = packed;
}
