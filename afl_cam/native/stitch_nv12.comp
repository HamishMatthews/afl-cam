#version 450

// LIVE GPU stitch, NV12 in → NV12 out. The spherical warp comes from
// PRE-COMPUTED MAP TEXTURES (map0/map1, R32G32F, one texel per camera-map
// pixel — generated once per calibration by dump_camera_params.py) instead
// of the analytic warp_cam math: the shader is pure texture sampling, so
// full-canvas (5304x2084) stitching is bandwidth-bound instead of ALU-bound.
// The map texel at the canvas pixel holds the exact (s,t) source coords
// cv2.remap consumes (invalid = -1), fetched with texelFetch — no
// interpolation, the value equals the old analytic warp_cam to float
// precision.
//
// ONE THREAD PER CANVAS PIXEL, no shared memory, no barriers, no 8-bit
// stores, no floatBitsToUint — the same low-register-pressure shape as the
// VALIDATED analytic shader. The 8-bit-storage (PACK8) and 4x2-region
// variants miscompiled on this libmali's LLVM backend (silent wrong output /
// LLVM ERROR on byte stores of texture-derived values) — every construct
// here is a proven one. Chroma is written by (even,even) threads only,
// sampling the blend at the 2x2 BLOCK CENTER (2bx+1, 2by+1) — the warp is
// defined on pixel corners, so the center is at +1.
//
// SSBO layout (uint32, low byte = value):
//   [0 .. cw*ch)                 Y plane (one uint per pixel)
//   [cw*ch .. cw*ch*2)           interleaved UV (one uint per byte)

layout(local_size_x = 16, local_size_y = 16) in;

layout(set = 0, binding = 0) uniform sampler2D y0;
layout(set = 0, binding = 1) uniform sampler2D uv0;
layout(set = 0, binding = 2) uniform sampler2D y1;
layout(set = 0, binding = 3) uniform sampler2D uv1;
layout(set = 0, binding = 4) uniform sampler2D w0;
layout(set = 0, binding = 5) uniform sampler2D w1;
layout(set = 0, binding = 6) uniform sampler2D map0;
layout(set = 0, binding = 7) uniform sampler2D map1;
layout(set = 0, binding = 8) buffer OutBuf { uint d[]; } OUT;
layout(set = 0, binding = 9) buffer ParamsBuf { float f[]; } P;

// BT.601 limited range (16..235). The decode/encode round trip is linear and
// self-consistent either way; the constant only sets the encoder's expected
// input range. (S1 measures jpegd's actual range — see verify_nv12.py.)
#define RANGE_FULL 0

vec3 nv12_to_rgb(float y, vec2 uv) {
#if RANGE_FULL
    float yf = y;
#else
    float yf = (y - 16.0 / 255.0) * (255.0 / 219.0);
#endif
    float u = uv.x - 128.0 / 255.0;
    float v = uv.y - 128.0 / 255.0;
    return clamp(vec3(yf + 1.402 * v,
                      yf - 0.344136 * u - 0.714136 * v,
                      yf + 1.772 * u), 0.0, 1.0);
}

float rgb_to_y(vec3 c) {
#if RANGE_FULL
    return clamp(dot(c, vec3(0.299, 0.587, 0.114)), 0.0, 1.0);
#else
    return clamp(dot(c, vec3(0.257, 0.504, 0.098)) + 16.0 / 255.0, 0.0, 1.0);
#endif
}

float rgb_to_u(vec3 c) {
#if RANGE_FULL
    return clamp(dot(c, vec3(-0.169, -0.331, 0.500)) + 0.5, 0.0, 1.0);
#else
    return clamp(dot(c, vec3(-0.148, -0.291, 0.439)) + 0.5, 0.0, 1.0);
#endif
}

float rgb_to_v(vec3 c) {
#if RANGE_FULL
    return clamp(dot(c, vec3(0.500, -0.419, -0.081)) + 0.5, 0.0, 1.0);
#else
    return clamp(dot(c, vec3(0.439, -0.368, -0.071)) + 0.5, 0.0, 1.0);
#endif
}

// RAW source pixel coords for one camera at canvas pixel p, or (-1,-1)
// outside the camera's map. texelFetch at the exact map texel — the map is
// ROI-sized and placed at params off, so mc = p - off indexes it directly.
vec2 fetch_map(sampler2D map_tex, int cam, vec2 p) {
    int base = 8 + cam * 28;
    vec2 off = vec2(P.f[base + 11], P.f[base + 12]);
    vec2 mwh = vec2(P.f[base + 13], P.f[base + 14]);
    vec2 mc = p - off;
    if (mc.x < 0.0 || mc.x >= mwh.x || mc.y < 0.0 || mc.y >= mwh.y)
        return vec2(-1.0);
    return texelFetch(map_tex, ivec2(mc), 0).xy;
}

// sample one camera's NV12 at raw pixel coords s, black when out of frame.
// NOTE: the guard is explicit because the sampler's border color (transparent
// black = Y=0,U=0,V=0) decodes to GREEN in YUV — NV12 black is Y=0,U=128,V=128.
vec3 sample_cam(sampler2D y_tex, sampler2D uv_tex, vec2 s, vec2 src_dims) {
    if (s.x < 0.0 || s.y < 0.0 || s.x >= src_dims.x - 1.0 || s.y >= src_dims.y - 1.0)
        return vec3(0.0);
    // texel-center correction: s is pixel-corner coords, texel centers at
    // (i+0.5)/N. The UV plane is half-res, so the same normalized coordinate
    // lands on the correct chroma sample.
    vec2 tc = (s + vec2(0.5)) / src_dims;
    float y = texture(y_tex, tc).r;
    vec2 uv = texture(uv_tex, tc).rg;
    return nv12_to_rgb(y, uv);
}

// blended RGB at one canvas pixel (pixel-corner coords p)
vec3 blend_at(vec2 p, vec2 src_dims, vec2 canvas_dims) {
    vec2 uv_c = (p + vec2(0.5)) / canvas_dims;
    vec2 s0 = fetch_map(map0, 0, p);
    vec2 s1 = fetch_map(map1, 1, p);
    return sample_cam(y0, uv0, s0, src_dims) * texture(w0, uv_c).r +
           sample_cam(y1, uv1, s1, src_dims) * texture(w1, uv_c).r;
}

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    int cw = int(P.f[0]), ch = int(P.f[1]);
    if (p.x >= cw || p.y >= ch) return;

    vec2 src_dims = vec2(P.f[2], P.f[3]);
    vec2 canvas_dims = vec2(P.f[0], P.f[1]);
    vec2 pc = vec2(p);

    vec3 rgb = blend_at(pc, src_dims, canvas_dims);
    uint yq = uint(rgb_to_y(rgb) * 255.0 + 0.5) & 0xffu;
    OUT.d[p.y * cw + p.x] = yq;

    // chroma: (even,even) threads only, blend at the block center (2bx+1,2by+1)
    if ((p.x & 1) == 0 && (p.y & 1) == 0) {
        vec3 rgbc = blend_at(pc + vec2(1.0, 1.0), src_dims, canvas_dims);
        uint uq = uint(rgb_to_u(rgbc) * 255.0 + 0.5) & 0xffu;
        uint vq = uint(rgb_to_v(rgbc) * 255.0 + 0.5) & 0xffu;
        uint uv_base = uint(cw * ch);
        OUT.d[uv_base + (p.y / 2) * cw + p.x] = uq;
        OUT.d[uv_base + (p.y / 2) * cw + p.x + 1] = vq;
    }
}
